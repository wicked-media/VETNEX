{
  "name": "@vetnex/database",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "dotenv -e ../../.env -- prisma generate",
    "migrate": "dotenv -e ../../.env -- prisma migrate deploy --schema prisma/schema.prisma",
    "migrate:dev": "dotenv -e ../../.env -- prisma migrate dev --schema prisma/schema.prisma",
    "migrate:diff": "dotenv -e ../../.env -- prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script",
    "seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "studio": "dotenv -e ../../.env -- prisma studio --schema prisma/schema.prisma",
    "typecheck": "tsc --noEmit",
    "test": "echo \"@vetnex/database has no unit tests; schema behaviour is covered by API integration tests\""
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@vetnex/authentication": "workspace:*",
    "@vetnex/permissions": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "dotenv-cli": "^8.0.0",
    "prisma": "6.19.3",
    "tsx": "^4.19.2",
    "typescript": "5.9.3"
  }
}
