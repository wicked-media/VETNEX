# Web app local environment (copy to apps/web/.env.local).
# Next.js only reads env files from the app directory, not the repository root.

# Internal origin the Next server uses for server components and the /api/vetnex proxy.
API_INTERNAL_URL="http://127.0.0.1:4000"

# Shows the synthetic demo accounts card on the sign-in page.
# MUST be unset ("false") in production.
NEXT_PUBLIC_SHOW_DEMO_LOGINS="true"
