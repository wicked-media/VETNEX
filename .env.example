# ---------------------------------------------------------------------------
# VETNEX local development environment
# Copy to .env (never commit .env). Values below are development-only defaults.
# ---------------------------------------------------------------------------

# Local PostgreSQL cluster managed by `pnpm db:start` (embedded-postgres).
# In Docker-based or hosted environments replace with your own connection string.
DATABASE_URL="postgresql://vetnex:vetnex@127.0.0.1:55432/vetnex"
TEST_DATABASE_URL="postgresql://vetnex:vetnex@127.0.0.1:55432/vetnex_test"
# Browser end-to-end tests own this database: `pnpm test:e2e` drops and rebuilds it.
E2E_DATABASE_URL="postgresql://vetnex:vetnex@127.0.0.1:55432/vetnex_e2e"

# API (NestJS)
NODE_ENV="development"
API_PORT="4000"
# Origins allowed to call the API directly (the web app proxies same-origin by default).
API_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Session cookie
SESSION_COOKIE_NAME="vetnex_session"
SESSION_TTL_HOURS="12"
# Set to "true" only when serving over HTTPS.
SESSION_COOKIE_SECURE="false"

# Development-only token delivery for invitations and password resets.
# No transactional email provider is configured in Phase 1, so security tokens are
# written to the API log and (in development only) returned to the requesting client.
# MUST be "false" in production.
AUTH_DEV_TOKEN_DELIVERY="true"

# Web (Next.js)
NEXT_PUBLIC_APP_NAME="VETNEX"
PREVIEW_HOST=""
NEXT_PUBLIC_SHOW_DEMO_LOGINS="true"
